# Optional: connect the live Shopify store. Without these, the site uses the
# placeholder catalog in lib/products.ts.
# Create a token in Shopify admin → Settings → Apps and sales channels →
# Develop apps (or the Headless channel) → Storefront API access token.
SHOPIFY_STORE_DOMAIN=nike-makknzjs.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10
