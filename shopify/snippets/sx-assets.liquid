{%- comment -%}
  Shared base styles + motion helpers for the sx sections. Safe to render more than once:
  the browser caches the files and the scripts guard against running twice.
  Usage: {% render 'sx-assets' %}
{%- endcomment -%}
<script>document.documentElement.classList.add('motion-ready');</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
{{ 'base.css' | asset_url | stylesheet_tag }}
{{ 'motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'motion.js' | asset_url }}" defer></script>
