{%- comment -%}
  Product grid — products from a collection as animated cards (hover image swap, quick add
  in a pop-up, filter tabs by product type). Cards are drawn by product-card.js from the JSON below.
{%- endcomment -%}
{% render 'sx-assets' %}
{{ 'product-grid.css' | asset_url | stylesheet_tag }}
{{ 'quick-view.css' | asset_url | stylesheet_tag }}
<script src="{{ 'site-cart.js' | asset_url }}" defer></script>
<script src="{{ 'quick-view.js' | asset_url }}" defer></script>
<script src="{{ 'product-card.js' | asset_url }}" defer></script>
<script src="{{ 'sections.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign c = s.collection
  assign products = c.products | default: collections.all.products
  assign types = products | map: 'type' | uniq
-%}
<div class="sx">
  <section class="section" data-pg data-limit="{{ s.limit }}">
    <div class="container">
      <div class="section-head">
        <div>
          {%- if s.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="h2" data-split style="margin-top:16px">{% render 'sx-accent', text: s.heading %}</h2>
        </div>
        {%- if s.show_tabs and types.size > 1 -%}
          <div class="tabs" role="group" aria-label="Filter products" data-reveal>
            <span class="tab-ink" aria-hidden="true"></span>
            <button type="button" class="tab" data-filter="all" aria-pressed="true">All</button>
            {%- for t in types limit: 4 -%}
              {%- if t != blank -%}<button type="button" class="tab" data-filter="{{ t | handleize }}" aria-pressed="false">{{ t | escape }}</button>{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <div class="pc-grid" data-pg-grid></div>
      {%- if s.btn_label != blank -%}
        <div style="display:flex;justify-content:center;margin-top:56px" data-reveal>
          <a class="btn btn-line" href="{{ c.url | default: routes.all_products_collection_url }}" data-magnetic>{{ s.btn_label | escape }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      {%- endif -%}
    </div>
    <script type="application/json" data-pg-json>
      [
        {%- for p in products limit: 24 -%}
          {%- liquid
            assign badge = ''
            if p.compare_at_price > p.price
              assign badge = 'Sale'
            elsif p.tags contains 'new' or p.tags contains 'New'
              assign badge = 'New'
            endif
            unless p.available
              assign badge = 'Sold out'
            endunless
          -%}
          {
            "id": {{ p.id | json }},
            "name": {{ p.title | json }},
            "price": {{ p.price | money | json }},
            "url": {{ p.url | json }},
            "type": {{ p.type | handleize | json }},
            "category": {{ p.type | handleize | json }},
            "categoryLabel": {{ p.type | json }},
            "look": {{ s.card_look | json }},
            "badge": {% if badge != blank %}{{ badge | json }}{% else %}null{% endif %},
            "tone": {{ s.tone | json }},
            "images": [
              {%- assign n = 0 -%}
              {%- for m in p.media limit: 5 -%}
                {%- if m.preview_image == blank -%}{%- continue -%}{%- endif -%}
                {%- if n > 0 -%},{%- endif -%}{{ m.preview_image | image_url: width: 1000 | json }}
                {%- assign n = n | plus: 1 -%}
              {%- endfor -%}
            ],
            {% render 'site-product-json', product: p %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>
  </section>
</div>

{% schema %}
{
  "name": "SX product grid",
  "tag": "section",
  "class": "section-sx-product-grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trending now" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This week’s *picks*." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_tabs", "label": "Filter tabs by product type", "default": true },
    { "type": "select", "id": "card_look", "label": "Card style", "default": "apparel", "options": [ { "value": "apparel", "label": "Apparel (hover shows 2nd image)" }, { "value": "footwear", "label": "Footwear (side-on, tilts on hover)" } ] },
    { "type": "color", "id": "tone", "label": "Card background", "default": "#f1f0ed" },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Shop all products" }
  ],
  "presets": [ { "name": "SX product grid" } ]
}
{% endschema %}
