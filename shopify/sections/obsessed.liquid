{%- comment -%}
  OBSESSED — big statement, short text and an endless strip of lifestyle photos.
{%- endcomment -%}
{{ 'obsessed.css' | asset_url | stylesheet_tag }}
<script src="{{ 'obsessed.js' | asset_url }}" defer></script>

{%- assign s = section.settings -%}
<section
  id="obsessed-{{ section.id }}"
  class="obs"
  data-obs-section
  style="--obs-speed: {{ s.speed }}s; --obs-pt: {{ s.pt }}px; --obs-pb: {{ s.pb }}px;"
>
  <div class="obs-head">
    {%- if s.title != blank -%}<h2 class="obs-title">{{ s.title }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="obs-text">{{ s.text }}</div>{%- endif -%}
  </div>
  {%- if section.blocks.size > 0 -%}
    <div class="obs-strip">
      {%- for pass in (1..2) -%}
        <div class="obs-set"{% if pass == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <figure class="obs-tile" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.image.alt, sizes: '(min-width: 750px) 30vw, 240px', widths: '450, 650, 900' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
            </figure>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Obsessed",
  "tag": "div",
  "class": "section-obsessed",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "OBSESSED." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We make things that work better and last longer. Our products solve real problems with clean design and honest materials.</p>" },
    { "type": "range", "id": "speed", "label": "Strip speed (seconds per loop)", "min": 10, "max": 120, "step": 5, "unit": "s", "default": 40 },
    { "type": "range", "id": "pt", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "pb", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    { "type": "image", "name": "Photo", "settings": [ { "type": "image_picker", "id": "image", "label": "Photo" } ] }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Obsessed", "blocks": [ { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" } ] }
  ]
}
{% endschema %}
