{%- comment -%}
  Nike Orbit — sneakers ride a large circle; the front one is the active product.
  Drag the shoes or the "wheel", click the front shoe for Quick view, click a size to add to bag.
  Each block is one shoe: product (+ optional images; default: the product's first 5 images).
{%- endcomment -%}
{{ 'nike-orbit.css' | asset_url | stylesheet_tag }}
{{ 'quick-view.css' | asset_url | stylesheet_tag }}
<script src="{{ 'site-cart.js' | asset_url }}" defer></script>
<script src="{{ 'quick-view.js' | asset_url }}" defer></script>
<script src="{{ 'nike-orbit.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign count = 0
  for block in section.blocks
    if block.settings.product != blank
      assign count = count | plus: 1
    endif
  endfor
  assign count_label = count | prepend: '0' | slice: -2, 2
-%}
<section
  id="nike-orbit-{{ section.id }}"
  class="orbit"
  data-orbit-section
  aria-label="{{ s.label | escape }}"
  style="--orbit-height: max({{ s.min_height }}px, {{ s.height }}vh); --orbit-accent: {{ s.accent }};"
>
  <div class="orbit-stage" data-orbit-stage>
    <div class="orbit-ring" data-orbit-ring aria-hidden="true"></div>
  </div>

  <div class="orbit-info" aria-live="polite">
    <div class="orbit-idx" data-orbit-idx>01 / {{ count_label }}</div>
    <h2 class="orbit-name" data-orbit-name></h2>
    <div class="orbit-price" data-orbit-price></div>
    <button type="button" class="orbit-details" data-orbit-details>{{ s.details_label }} <span aria-hidden="true">&rarr;</span></button>
  </div>

  <div
    class="orbit-wheel"
    data-orbit-wheel
    role="slider"
    tabindex="0"
    aria-label="Turn the wheel to choose a sneaker"
    aria-valuemin="1"
    aria-valuemax="{{ count }}"
    aria-valuenow="1"
  >
    <span class="orbit-wheel-dot" aria-hidden="true"></span>
    <div class="orbit-wheel-track" data-orbit-track></div>
    <div class="orbit-wheel-labels" aria-hidden="true"><span>01</span><span>{{ s.wheel_label }}</span><span data-orbit-max>{{ count_label }}</span></div>
  </div>

  {%- if s.quick_add -%}
    <div class="orbit-sizes" data-orbit-sizes>
      <div class="orbit-sizes-grid" role="group" aria-label="Quick add a size"></div>
      <p class="orbit-msg" data-orbit-msg aria-live="polite"></p>
    </div>
  {%- endif -%}

  <script type="application/json" data-orbit-json>
    [
      {%- assign first = true -%}
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p == blank -%}{%- continue -%}{%- endif -%}
        {%- unless first -%},{%- endunless -%}
        {%- assign first = false -%}
        {
          "name": {{ p.title | json }},
          "price": {{ p.price | money | json }},
          "url": {{ p.url | json }},
          "images": [
            {%- assign n = 0 -%}
            {%- for k in (1..5) -%}
              {%- assign key = 'image_' | append: k -%}
              {%- assign img = block.settings[key] -%}
              {%- if img != blank -%}
                {%- if n > 0 -%},{%- endif -%}{{ img | image_url: width: 1400 | json }}
                {%- assign n = n | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if n == 0 -%}
              {%- for m in p.media limit: 5 -%}
                {%- if m.preview_image == blank -%}{%- continue -%}{%- endif -%}
                {%- if n > 0 -%},{%- endif -%}{{ m.preview_image | image_url: width: 1400 | json }}
                {%- assign n = n | plus: 1 -%}
              {%- endfor -%}
            {%- endif -%}
          ],
          {% render 'site-product-json', product: p %}
        }
      {%- endfor -%}
    ]
  </script>
</section>

{% schema %}
{
  "name": "Nike Orbit",
  "tag": "div",
  "class": "section-nike-orbit",
  "settings": [
    { "type": "text", "id": "label", "label": "Section name (screen readers)", "default": "Nike Orbit" },
    { "type": "text", "id": "details_label", "label": "Details link", "default": "View details" },
    { "type": "text", "id": "wheel_label", "label": "Wheel label", "default": "Drag the wheel" },
    { "type": "checkbox", "id": "quick_add", "label": "Show size quick add", "default": true, "info": "Uses the product option named Size (or the first option)." },
    { "type": "color", "id": "accent", "label": "Accent (wheel dot, added tick)", "default": "#e0262f" },
    { "type": "range", "id": "height", "label": "Section height", "min": 60, "max": 100, "step": 2, "unit": "vh", "default": 100 },
    { "type": "range", "id": "min_height", "label": "Min height", "min": 560, "max": 1000, "step": 20, "unit": "px", "default": 760 }
  ],
  "blocks": [
    {
      "type": "shoe",
      "name": "Shoe",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "paragraph", "content": "Images: transparent PNG/WebP, shoe facing left or right. Leave empty to use the product's images." },
        { "type": "image_picker", "id": "image_1", "label": "Image 1 (shown on the wheel)" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" },
        { "type": "image_picker", "id": "image_3", "label": "Image 3" },
        { "type": "image_picker", "id": "image_4", "label": "Image 4" },
        { "type": "image_picker", "id": "image_5", "label": "Image 5" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Nike Orbit",
      "blocks": [ { "type": "shoe" }, { "type": "shoe" }, { "type": "shoe" }, { "type": "shoe" }, { "type": "shoe" }, { "type": "shoe" }, { "type": "shoe" } ]
    }
  ]
}
{% endschema %}
