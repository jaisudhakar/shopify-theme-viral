{%- comment -%} Category tiles — each block links a collection; hover fills the tile from the corner. {%- endcomment -%}
{% render 'sx-assets' %}
{{ 'sections.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<div class="sx">
  <section class="section" style="padding-top: {{ s.pt }}px; padding-bottom: {{ s.pb }}px;">
    <div class="container">
      <div class="section-head">
        <div>
          {%- if s.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="h2" data-split style="margin-top:16px">{% render 'sx-accent', text: s.heading %}</h2>
        </div>
        {%- if s.link_label != blank -%}
          <a class="link-arrow" href="{{ s.link_url | default: routes.collections_url }}" data-reveal>{{ s.link_label | escape }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        {%- endif -%}
      </div>
      <div class="cats-grid" data-reveal-stagger>
        {%- for block in section.blocks -%}
          {%- liquid
            assign c = block.settings.collection
            assign img = block.settings.image | default: c.featured_image
            assign label = block.settings.label | default: c.title
            assign n = forloop.index | prepend: '0' | slice: -2, 2
          -%}
          <a class="cat" href="{{ c.url | default: '#' }}" data-reveal data-cursor="Shop" style="--tone: {{ block.settings.tone }};" {{ block.shopify_attributes }}>
            <span class="cat-n">{{ n }}</span>
            <span class="cat-img">
              {%- if img != blank -%}
                <img src="{{ img | image_url: width: 800 }}" alt="" width="{{ img.width }}" height="{{ img.height }}" loading="lazy" decoding="async">
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </span>
            <span class="cat-foot">
              <span>
                <span class="cat-name">{{ label | escape }}</span>
                {%- if c != blank -%}<span class="cat-count">{{ c.products_count }} {% if c.products_count == 1 %}style{% else %}styles{% endif %}</span>{%- endif -%}
              </span>
              <span class="cat-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "SX category tiles",
  "tag": "section",
  "class": "section-sx-categories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your *fit*.", "info": "Wrap one phrase in *asterisks* for the italic accent." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all products" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "range", "id": "pt", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pb", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label (default: collection title)" },
        { "type": "image_picker", "id": "image", "label": "Image (default: collection image)" },
        { "type": "color", "id": "tone", "label": "Tile colour", "default": "#ebe7e1" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "SX category tiles", "blocks": [ { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" } ] } ]
}
{% endschema %}
