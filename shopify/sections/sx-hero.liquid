{%- comment -%}
  Hero — split headline, three floating product cards with mouse/scroll parallax,
  a spinning badge and a product chip. Wrap one word in *asterisks* for the accent font.
{%- endcomment -%}
{% render 'sx-assets' %}
{{ 'hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero.js' | asset_url }}" defer></script>

{%- assign s = section.settings -%}
<div class="sx">
  <section class="hero" data-hero aria-label="Introduction" style="--hero-bg: {{ s.bg }};">
    <div class="hero-bg" aria-hidden="true"><span class="hero-blob b1"></span><span class="hero-blob b2"></span></div>
    {%- if s.bg_word != blank -%}<div class="hero-word" aria-hidden="true">{{ s.bg_word | escape }}</div>{%- endif -%}
    <div class="hero-in">
      <div class="hero-copy">
        {%- if s.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h1 class="display hero-title" data-split>{% render 'sx-accent', text: s.heading %}</h1>
        {%- if s.text != blank -%}<p class="lead" data-reveal style="--rd:.45s">{{ s.text | escape }}</p>{%- endif -%}
        <div class="hero-ctas" data-reveal style="--rd:.6s">
          {%- if s.btn_label != blank -%}
            <a class="btn btn-dark" href="{{ s.btn_link | default: routes.all_products_collection_url }}" data-magnetic>
              {{ s.btn_label | escape }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          {%- endif -%}
          {%- if s.link_label != blank -%}
            <a class="link-arrow" href="{{ s.link_url | default: '#' }}">
              {{ s.link_label | escape }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        {%- assign depths = '0.5,1,0.3' | split: ',' -%}
        {%- for k in (1..3) -%}
          {%- assign key = 'image_' | append: k -%}
          {%- assign tone_key = 'tone_' | append: k -%}
          {%- assign img = s[key] -%}
          <div class="hero-layer" data-depth="{{ depths[forloop.index0] }}">
            <figure class="hero-card c{{ k }}" style="--tone: {{ s[tone_key] }};">
              {%- if img != blank -%}
                <img src="{{ img | image_url: width: 900 }}" alt="" width="{{ img.width }}" height="{{ img.height }}" decoding="async"{% if k == 2 %} fetchpriority="high"{% endif %}>
              {%- else -%}
                {{ 'apparel-1' | placeholder_svg_tag }}
              {%- endif -%}
            </figure>
          </div>
        {%- endfor -%}
        {%- if s.badge != blank -%}
          <div class="hero-layer" data-depth="1.4">
            <div class="hero-badge">
              <svg viewBox="0 0 100 100"><defs><path id="hero-circle-{{ section.id }}" d="M50 50 m-37 0 a37 37 0 1 1 74 0 a37 37 0 1 1 -74 0"/></defs><text><textPath href="#hero-circle-{{ section.id }}">{{ s.badge | escape }} • {{ s.badge | escape }} • {{ s.badge | escape }} •</textPath></text></svg>
              <b>★</b>
            </div>
          </div>
        {%- endif -%}
        {%- assign chip = s.chip_product -%}
        {%- if chip != blank -%}
          <div class="hero-layer" data-depth="1.2" style="pointer-events:none">
            <a class="hero-chip" href="{{ chip.url }}" style="pointer-events:auto" tabindex="-1">
              {%- if chip.featured_image != blank -%}<img src="{{ chip.featured_image | image_url: width: 120 }}" alt="" width="46" height="46">{%- endif -%}
              <span><strong>{{ chip.title | escape }}</strong>{{ chip.price | money }}</span><span class="dot"></span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
    {%- if s.scroll_cue -%}<a class="hero-scroll" href="#MainContent"><i></i><span>Scroll</span></a>{%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "SX hero",
  "tag": "section",
  "class": "section-sx-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New collection · Premium streetwear" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the *everyday* athlete.", "info": "Wrap one phrase in *asterisks* for the italic accent." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Heavyweight fleece, clean cuts and sneakers built to keep up. Explore the new drop." },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "btn_link", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Second link label", "default": "Explore Nike Orbit" },
    { "type": "url", "id": "link_url", "label": "Second link" },
    { "type": "header", "content": "Product cards" },
    { "type": "image_picker", "id": "image_1", "label": "Card 1 image", "info": "Transparent PNG/WebP works best." },
    { "type": "color", "id": "tone_1", "label": "Card 1 colour", "default": "#ebe5d9" },
    { "type": "image_picker", "id": "image_2", "label": "Card 2 image (front, largest)" },
    { "type": "color", "id": "tone_2", "label": "Card 2 colour", "default": "#dfe7df" },
    { "type": "image_picker", "id": "image_3", "label": "Card 3 image" },
    { "type": "color", "id": "tone_3", "label": "Card 3 colour", "default": "#e4e4e2" },
    { "type": "product", "id": "chip_product", "label": "Product chip" },
    { "type": "text", "id": "badge", "label": "Spinning badge text", "default": "New drop" },
    { "type": "text", "id": "bg_word", "label": "Outlined background word", "default": "MOVE" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f6f4f0" },
    { "type": "checkbox", "id": "scroll_cue", "label": "Show scroll cue", "default": true }
  ],
  "presets": [ { "name": "SX hero" } ]
}
{% endschema %}
